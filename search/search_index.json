{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"Web of CHENNYO"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f CHENNYO\uff0c\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9\u3002</p> <p>\u8fd9\u91cc\u7528\u6765\u8bb0\u5f55\u6211\u7684\u8bfe\u7a0b\u7b14\u8bb0\u3001\u5b66\u4e60\u8fc7\u7a0b\uff0c\u4ee5\u53ca\u751f\u6d3b\u4e2d\u503c\u5f97\u7559\u4e0b\u7684\u70b9\u6ef4\u3002</p>"},{"location":"about/#_2","title":"\u5173\u4e8e\u6211","text":"<ul> <li>\u5174\u8da3\uff1a\u5728\u8fd9\u91cc\u586b\u5199\u4f60\u559c\u6b22\u7684\u4e8b\u60c5\u3002</li> <li>\u6b63\u5728\u5b66\u4e60\uff1a\u5728\u8fd9\u91cc\u586b\u5199\u6700\u8fd1\u5b66\u4e60\u7684\u5185\u5bb9\u3002</li> <li>\u8054\u7cfb\u65b9\u5f0f\uff1a\u5728\u8fd9\u91cc\u586b\u5199\u4f60\u613f\u610f\u516c\u5f00\u7684\u8054\u7cfb\u65b9\u5f0f\u3002</li> </ul> <p>\u8fd9\u4e9b\u6587\u5b57\u90fd\u53ef\u4ee5\u968f\u65f6\u4fee\u6539\uff0c\u6162\u6162\u628a\u8fd9\u91cc\u53d8\u6210\u5c5e\u4e8e\u4f60\u81ea\u5df1\u7684\u7a7a\u95f4\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u6574\u7406\u6211\u7684\u8bfe\u7a0b\u7b14\u8bb0\u3001\u5b66\u4e60\u5fc3\u5f97\u548c\u5b9e\u8df5\u8bb0\u5f55\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u5b66\u4e60\u7b14\u8bb0 \u2014 \u4ece\u6807\u9898\u3001\u6b63\u6587\u5230\u4ee3\u7801\uff0c\u5feb\u901f\u4e86\u89e3\u6587\u7ae0\u683c\u5f0f\u3002</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u5b66\u4e60\u7b14\u8bb0","text":"<p>\u8bfe\u7a0b\u540d\u79f0\uff1a\u793a\u4f8b\u8bfe\u7a0b \u00b7 \u4f5c\u8005\uff1aCHENNYO</p> <p>\u8fd9\u91cc\u7528\u4e00\u4e24\u53e5\u8bdd\u6982\u62ec\u8fd9\u7bc7\u6587\u7ae0\uff1a\u5b66\u4e60\u4e86\u4ec0\u4e48\u3001\u89e3\u51b3\u4e86\u4ec0\u4e48\u95ee\u9898\uff0c\u6216\u8005\u5e0c\u671b\u8bfb\u8005\u83b7\u5f97\u4ec0\u4e48\u3002</p>"},{"location":"course/example/#1","title":"1. \u5b66\u4e60\u76ee\u6807","text":"<ul> <li>\u7406\u89e3\u672c\u8282\u8bfe\u7684\u6838\u5fc3\u6982\u5ff5\u3002</li> <li>\u7528\u81ea\u5df1\u7684\u8bdd\u6574\u7406\u77e5\u8bc6\u70b9\u3002</li> <li>\u5b8c\u6210\u4e00\u4e2a\u7b80\u5355\u7ec3\u4e60\u3002</li> </ul>"},{"location":"course/example/#2","title":"2. \u6838\u5fc3\u77e5\u8bc6","text":"<p>\u6587\u7ae0\u4f7f\u7528 Markdown \u683c\u5f0f\u7f16\u5199\u3002\u7528 <code>#</code> \u8868\u793a\u6587\u7ae0\u6807\u9898\uff0c\u7528 <code>##</code> \u8868\u793a\u5c0f\u8282\u6807\u9898\uff0c\u7528 <code>###</code> \u8868\u793a\u66f4\u5c0f\u4e00\u7ea7\u7684\u6807\u9898\u3002</p> <p>\u6b63\u6587\u76f4\u63a5\u5199\u5728\u8fd9\u91cc\uff0c\u6bb5\u843d\u4e4b\u95f4\u7a7a\u4e00\u884c\u3002\u53ef\u4ee5\u7528 \u52a0\u7c97 \u5f3a\u8c03\u91cd\u70b9\uff0c\u4e5f\u53ef\u4ee5\u7528 \u659c\u4f53 \u8865\u5145\u8bf4\u660e\u3002</p>"},{"location":"course/example/#_2","title":"\u5217\u8868\u548c\u8868\u683c","text":"<ol> <li>\u5148\u4ecb\u7ecd\u80cc\u666f\u3002</li> <li>\u518d\u89e3\u91ca\u5177\u4f53\u6b65\u9aa4\u3002</li> <li>\u6700\u540e\u8bb0\u5f55\u7ed3\u8bba\u3002</li> </ol> \u77e5\u8bc6\u70b9 \u6211\u7684\u7406\u89e3 \u6807\u9898 \u8ba9\u6587\u7ae0\u7ed3\u6784\u6e05\u695a \u94fe\u63a5 \u65b9\u4fbf\u67e5\u770b\u53c2\u8003\u8d44\u6599 \u4ee3\u7801\u5757 \u5c55\u793a\u53ef\u4ee5\u8fd0\u884c\u7684\u793a\u4f8b"},{"location":"course/example/#3","title":"3. \u793a\u4f8b\u4ee3\u7801","text":"<p>\u5728\u4e09\u679a\u53cd\u5f15\u53f7\u540e\u5199\u4e0a\u8bed\u8a00\u540d\u79f0\uff0c\u5c31\u80fd\u5c55\u793a\u4ee3\u7801\uff1a</p> <pre><code>def greet(name):\n    return f\"\u4f60\u597d\uff0c{name}\uff01\"\n\nprint(greet(\"CHENNYO\"))\n</code></pre> <p>\u5b66\u4e60\u63d0\u793a</p> <p>\u8fd9\u91cc\u53ef\u4ee5\u8bb0\u5f55\u5bb9\u6613\u5fd8\u8bb0\u7684\u7ec6\u8282\uff0c\u6216\u63d0\u9192\u81ea\u5df1\u4e0b\u6b21\u590d\u4e60\u7684\u5185\u5bb9\u3002</p>"},{"location":"course/example/#4","title":"4. \u7ec3\u4e60\u4e0e\u603b\u7ed3","text":"<p>\u5c1d\u8bd5\u628a\u4e0a\u9762\u793a\u4f8b\u4e2d\u7684\u540d\u5b57\u6539\u6210\u81ea\u5df1\u7684\u540d\u5b57\uff0c\u518d\u8bb0\u5f55\u4f60\u7684\u7ed3\u679c\u3002</p> <ul> <li>\u4eca\u5929\u5b66\u5230\u4e86\u4ec0\u4e48\uff1f</li> <li>\u54ea\u4e2a\u5730\u65b9\u8fd8\u4e0d\u660e\u767d\uff1f</li> <li>\u4e0b\u4e00\u6b65\u51c6\u5907\u5c1d\u8bd5\u4ec0\u4e48\uff1f</li> </ul>"},{"location":"course/example/#5","title":"5. \u53c2\u8003\u8d44\u6599","text":"<ul> <li>Markdown \u57fa\u7840\u8bed\u6cd5</li> <li>\u8fd4\u56de\u8bfe\u7a0b\u5217\u8868</li> </ul>"},{"location":"course/example/#_3","title":"\u4ee5\u540e\u5982\u4f55\u65b0\u589e\u6587\u7ae0","text":"<ol> <li>\u5728 <code>docs/course/</code> \u6587\u4ef6\u5939\u91cc\u65b0\u5efa\u4e00\u4e2a\u6587\u4ef6\uff0c\u4f8b\u5982 <code>my-first-note.md</code>\u3002</li> <li>\u53c2\u8003\u8fd9\u7bc7\u6587\u7ae0\u7684\u683c\u5f0f\uff0c\u586b\u5199\u6807\u9898\u548c\u6b63\u6587\u3002</li> <li>\u6253\u5f00 <code>docs/course/index.md</code>\uff0c\u5728\u6587\u7ae0\u5217\u8868\u4e2d\u6dfb\u52a0\u4e00\u884c\uff1a</li> </ol> <pre><code>- [\u6211\u7684\u7b2c\u4e00\u7bc7\u7b14\u8bb0](my-first-note.md) \u2014 \u4e00\u53e5\u8bdd\u7b80\u4ecb\u3002\n</code></pre> <ol> <li>\u4fdd\u5b58\u6587\u4ef6\uff0c\u672c\u5730\u9884\u89c8\u4f1a\u81ea\u52a8\u66f4\u65b0\u3002</li> </ol>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u6536\u85cf\u670b\u53cb\u7684\u7f51\u7ad9\u548c\u559c\u6b22\u7684\u5185\u5bb9\u3002\u4e0b\u9762\u662f\u793a\u4f8b\u94fe\u63a5\uff0c\u4e4b\u540e\u53ef\u4ee5\u6362\u6210\u4f60\u7684\u670b\u53cb\u3002</p> <ul> <li>\u793a\u4f8b\u53cb\u94fe\u4e00 \u2014 \u5728\u8fd9\u91cc\u5199\u670b\u53cb\u7684\u7f51\u7ad9\u4ecb\u7ecd\u3002</li> <li>\u793a\u4f8b\u53cb\u94fe\u4e8c \u2014 \u5728\u8fd9\u91cc\u5199\u53e6\u4e00\u4f4d\u670b\u53cb\u7684\u7f51\u7ad9\u4ecb\u7ecd\u3002</li> </ul>"}]}